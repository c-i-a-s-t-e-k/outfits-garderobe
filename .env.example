SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=yourdomain.up.railway.app
DATABASE_URL=postgresql://...  # auto-injected by Railway PostgreSQL service
MEDIA_ROOT=/data/media  # production: a directory beneath the mounted Railway volume; defaults to <project>/media in dev
# Brevo v3 API key — Settings → SMTP & API → API Keys (xkeysib-…), not an SMTP key
BREVO_API_KEY=xkeysib-...
# Must match a verified sender in Brevo (Senders, Domains & Dedicated IPs → Senders) exactly
DEFAULT_FROM_EMAIL=
